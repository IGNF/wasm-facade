{
  "name": "wasm-facade-repository",
  "private": true,
  "workspaces": [
    "npm"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p npm/tsconfig.json",
    "test": "bun test npm",
    "test:node": "cd npm && node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "example:check": "cd examples/filters && bun ../../npm/src/cli.ts check",
    "site": "bun site/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/react": "^19.1.0",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "typescript": "~6.0.2"
  }
}
