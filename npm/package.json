{
  "name": "wasm-facade",
  "version": "0.2.0",
  "description": "A public API declared once in Rust, written as an idiomatic TypeScript facade over its wasm-bindgen exports, React hooks, a reference, and any binding a plugin adds",
  "license": "MIT",
  "homepage": "https://ignf.github.io/wasm-facade/",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IGNF/wasm-facade.git",
    "directory": "npm"
  },
  "keywords": [
    "wasm",
    "wasm-bindgen",
    "rust",
    "typescript",
    "codegen",
    "bindings",
    "react"
  ],
  "engines": {
    "node": ">=20",
    "bun": ">=1.2"
  },
  "bin": {
    "wasm-facade": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:node": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "lint": "biome check .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "react": "^19.3.1",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  }
}
