{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/IGNF/wasm-facade/main/data/api.schema.json",
  "title": "wasm-facade's API file, schema 1",
  "description": "A public API declared in Rust, as `wasm-facade extract` writes it: the declared items (the structs, enums, functions, impl blocks and host traits carrying the configured inert attribute), and the calls they name among the exported classes' methods. Version 1; a change that a reader of version 1 cannot read raises `schema`.",
  "type": "object",
  "required": ["schema", "items", "calls"],
  "properties": {
    "$comment": { "type": "string" },
    "schema": { "const": 1 },
    "items": {
      "description": "The declarations, sorted by name",
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "calls": {
      "description": "The calls the declarations name (by the configured `call_keys`), by their exported name",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/call" }
    }
  },
  "$defs": {
    "keys": {
      "description": "An attribute's keys as written: `key = \"text\"`, `key = 3`, `key = true`, or a flag `key` (true)",
      "type": "object",
      "additionalProperties": { "type": ["string", "integer", "boolean", "null"] }
    },
    "field": {
      "type": "object",
      "required": ["name", "type", "doc", "api"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "doc": { "type": "string" },
        "api": { "$ref": "#/$defs/keys" }
      }
    },
    "param": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "description": "The Rust type as written, spaces only after commas", "type": "string" },
        "api": {
          "description": "Its own keys (`#[api(ts = \"…\")] camera: Camera`), where it has some",
          "$ref": "#/$defs/keys"
        }
      }
    },
    "signature": {
      "type": "object",
      "required": ["name", "export", "doc", "params", "returns", "async", "flags", "api"],
      "properties": {
        "name": { "description": "Its Rust name", "type": "string" },
        "export": { "description": "Its exported name (`js_name`), its Rust name else", "type": "string" },
        "doc": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
        "returns": { "type": ["string", "null"] },
        "async": { "type": "boolean" },
        "flags": {
          "description": "The export attribute's flags: constructor, getter, setter…",
          "type": "array",
          "items": { "type": "string" }
        },
        "api": { "$ref": "#/$defs/keys" }
      }
    },
    "item": {
      "type": "object",
      "required": ["kind", "name", "doc", "api"],
      "properties": {
        "kind": {
          "description": "A host is a trait, usually never compiled, declaring a hand-written class's methods; a reader may ignore a kind it does not know",
          "enum": ["struct", "enum", "function", "class", "host"]
        },
        "name": { "type": "string" },
        "doc": { "description": "Its doc comment's lines, joined", "type": "string" },
        "api": { "$ref": "#/$defs/keys" },
        "fields": {
          "description": "A struct's; a tuple struct's named by position (`0`, `1`…)",
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "variants": {
          "description": "An enum's",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "doc"],
            "properties": {
              "name": { "type": "string" },
              "doc": { "type": "string" },
              "api": { "description": "Its keys, where it has some", "$ref": "#/$defs/keys" },
              "fields": {
                "description": "Its fields (an event's payload), where it has some; a tuple's named by position",
                "type": "array",
                "items": { "$ref": "#/$defs/field" }
              }
            }
          }
        },
        "methods": {
          "description": "A class's or a host's",
          "type": "array",
          "items": { "$ref": "#/$defs/signature" }
        },
        "deps": {
          "description": "A class's dependencies, its `deps` key (`\"map: GeoMap, engine: Engine\"`) read in their order: each a name and its type as the project gives it (TypeScript's), taken first by the constructor; where it has a `deps` key",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": { "name": { "type": "string" }, "type": { "type": "string" } }
          }
        },
        "export": { "description": "A function's (and its signature's other keys)", "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/param" } },
        "returns": { "type": ["string", "null"] },
        "async": { "type": "boolean" },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "call": {
      "type": "object",
      "required": ["doc", "params"],
      "properties": {
        "doc": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/param" } }
      }
    }
  }
}
